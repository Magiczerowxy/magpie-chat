{
  "name": "@magpie-community/page-chat",
  "version": "0.1.21",
  "description": "在 magpie 窗口里加一个「对话」页面：用 magpie 自己的模型、MCP 服务器、指令和技能聊天，支持图片与 LaTeX。A chat page inside magpie's window: talk with magpie's own models, MCP servers, instructions and skills, with images and LaTeX.",
  "files": [
    "index.mjs",
    "lib",
    "chat",
    "page",
    "assets",
    "serve.mjs",
    "start-server.cmd",
    "start-server.vbs",
    "install-autostart.cmd",
    "install-autostart.ps1",
    "README.md",
    "SERVE.md",
    "LICENSE"
  ],
  "keywords": [
    "magpie",
    "magpie-page",
    "magpie-plugin",
    "opencode",
    "opencode-plugin",
    "chat",
    "llm"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Magiczerowxy/magpie-chat.git"
  },
  "bugs": {
    "url": "https://github.com/Magiczerowxy/magpie-chat/issues"
  },
  "homepage": "https://github.com/Magiczerowxy/magpie-chat#readme",
  "engines": {
    "magpie": ">=0.1.1340"
  },
  "magpie": {
    "icon": "data:image/svg+xml;base64,",
    "page": {
      "title": "Chat",
      "titles": {
        "zh": "对话",
        "zh-TW": "對話",
        "ja": "チャット"
      },
      "file": "page/index.html",
      "icon": "assets/icon.svg"
    }
  },
  "scripts": {
    "start": "node -e \"import('./index.mjs')\""
  },
  "main": "./index.mjs",
  "type": "module"
